{
  "name": "Fraud Evidence Console",
  "dataColors": [
    "#4F46E5",
    "#0E7490",
    "#7C3AED",
    "#CB4257",
    "#1F8A70",
    "#BD761B",
    "#5B6B8C",
    "#D17A9A",
    "#6D9F71",
    "#8C6D4F"
  ],
  "good": "#1F8A70",
  "neutral": "#BD761B",
  "bad": "#CB4257",
  "maximum": "#0E7490",
  "minimum": "#F5F1EA",
  "background": "#F5F1EA",
  "foreground": "#1C2330",
  "tableAccent": "#4F46E5",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 34,
      "color": "#101A2E"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 16,
      "color": "#101A2E"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#1C2330"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#4E5563"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFDF9"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E5DED2"
              }
            },
            "radius": 8
          }
        ],
        "visualHeader": [
          {
            "show": true,
            "background": {
              "solid": {
                "color": "#FFFDF9"
              }
            },
            "foreground": {
              "solid": {
                "color": "#4E5563"
              }
            },
            "border": {
              "solid": {
                "color": "#FFFDF9"
              }
            }
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#101A2E"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFDF9"
              }
            },
            "alignment": "left",
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "subTitle": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#4E5563"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F5F1EA"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F5F1EA"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#101A2E"
              }
            },
            "fontSize": 28,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#4E5563"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "kpi": {
      "*": {
        "indicator": [
          {
            "color": {
              "solid": {
                "color": "#4F46E5"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#1C2330"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFDF9"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#4E5563"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFDF9"
              }
            },
            "fontSize": 10,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridVertical": false,
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#EFEAE1"
              }
            },
            "rowPadding": 6,
            "outlineColor": {
              "solid": {
                "color": "#E5DED2"
              }
            },
            "outlineWeight": 1
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#4E5563"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F5F1EA"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI Semibold",
            "bold": true
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#1C2330"
              }
            },
            "backColor": {
              "solid": {
                "color": "#FFFDF9"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#4E5563"
              }
            },
            "backColor": {
              "solid": {
                "color": "#F5F1EA"
              }
            },
            "fontSize": 9,
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "dataPoint": [
          {
            "fill": {
              "solid": {
                "color": "#4F46E5"
              }
            }
          }
        ]
      }
    },
    "barChart": {
      "*": {
        "dataPoint": [
          {
            "fill": {
              "solid": {
                "color": "#4F46E5"
              }
            }
          }
        ]
      }
    },
    "columnChart": {
      "*": {
        "dataPoint": [
          {
            "fill": {
              "solid": {
                "color": "#0E7490"
              }
            }
          }
        ]
      }
    }
  }
}
