  "knownCaveats": [
    {
      "id": "C1",
      "title": "The raw datasets are absent",
      "detail": "fraudTrain.csv and fraudTest.csv are referenced by hash and size but are not in the workspace, so the notebook cannot be re-run end to end. Every Phase 2 value is derived from the generated artifacts only.",
      "sources": "logs/data_fingerprint.json, manifest sources"
    },
    {
      "id": "C2",
      "title": "No native Power BI authoring runtime",
      "detail": "The pack is CSV + DAX + theme + page spec. It has not been opened in Power BI Desktop, so the model is verified by schema, count and arithmetic checks only.",
      "sources": "powerbi/manifest.json"
    },
    {
      "id": "C3",
      "title": "Log events have no timestamps",
      "detail": "The notebook outputs, warning register and build logs carry no reliable per-event times. Sequence is preserved by cell and line number, and no timestamp is invented.",
      "sources": "data/notebook.json, logs/build.log"
    },
    {
      "id": "C4",
      "title": "A single research program",
      "detail": "The workspace contains one program with nine phases. Comparisons are between model variants, folds and detectors - not between independent projects.",
      "sources": "app/public/data/phase2/program.json"
    },
    {
      "id": "C5",
      "title": "Partial runtime telemetry",
      "detail": "The run records total wall clock, six embedding durations and the SHAP duration. There is no per-phase or per-model runtime ledger, so no runtime anomaly detection is attempted.",
      "sources": "manifest run.embeddingTimes"
    },
    {
      "id": "C6",
      "title": "The same warning can appear in two sources",
      "detail": "A warning present in both the notebook output and the warning register is counted once in the warning families and twice in the raw event stream. The UI states which number it is showing.",
      "sources": "data/phase2/logs.json"
    },
    {
      "id": "C7",
      "title": "Related findings are phase-level",
      "detail": "An artifact is linked to the findings of its phase. The link is labelled as phase-level rather than a claim that the artifact is the source of that finding.",
      "sources": "data/phase2/artifacts.json"
    },
    {
      "id": "C8",
      "title": "The manifest's phase cell range omits each phase's final cell",
      "detail": "For every phase, the notebook records one more cell in that phase than the manifest's cell_start/cell_end span (for example P0 is 13-18 in the manifest while cell 19 also carries the P0 phase). Range-based provenance checks would therefore report false mismatches, so the console uses the notebook's own cell-to-phase mapping as the authority and records the producing cell against it.",
      "sources": "data/notebook.json, manifest phases"
    }
  ]
}