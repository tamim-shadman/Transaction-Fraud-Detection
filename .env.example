# ==============================================================================
# Transaction Fraud Detection Analytics Platform — Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust values for your environment.
# Never commit actual secret keys or private production passwords.

# Environment Mode: development | testing | production
APP_ENV=production

# Server Network Binding
APP_HOST=127.0.0.1
APP_PORT=4173

# Application Base Path (e.g. "/" or "/fraud-console/")
BASE_URL=/

# File System Storage Paths (Relative to repository root or absolute)
DATA_DIR=app/public/data
TABLES_DIR=tables
FIGURES_DIR=figures
LOG_DIR=logs
BACKUP_DIR=backups
DIST_DIR=app/dist

# Operational & Observability Controls
LOG_LEVEL=INFO
ENABLE_DIAGNOSTICS=true
HEALTHCHECK_TIMEOUT_SEC=5

# Storage Management & Cost Controls
STORAGE_LIMIT_MB=500
BACKUP_RETENTION_DAYS=30
MAX_BACKUP_COUNT=10

# Security Controls
ENABLE_CORS=false
ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173
